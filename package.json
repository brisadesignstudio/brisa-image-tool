{
  "name": "brisa-image-tool",
  "private": true,
  "version": "0.1.0",
  "description": "Preparador de imágenes de Brisa Design Studio. Todo se procesa en el navegador.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:archivo": "tsc --noEmit && vite build --mode archivo",
    "publicar": "bash scripts/publicar.sh",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures": "python3 scripts/make-fixtures.py && node scripts/make-logo-fixture.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wasm-feature-detect": "^1.8.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^6.0.2",
    "vite": "~8.3.0",
    "vitest": "^5.0.5"
  }
}
